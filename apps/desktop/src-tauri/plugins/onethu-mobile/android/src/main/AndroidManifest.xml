<?xml version="1.0" encoding="utf-8"?>
<!--
  R18c：扫码期间前台服务保活（插件 Android 库清单）。

  本文件位于仓库内的插件模块，由 manifest merger 合并进 app 模块
  （gen/android 实际工程不入库、本机软链到 /home/lin/onethu-android），
  因此权限与 Service 声明随仓库入库，无需改本地工程或构建脚本 sed。

  - FOREGROUND_SERVICE：API 28+ 启动前台服务的前置权限（normal）。
  - FOREGROUND_SERVICE_DATA_SYNC：API 34+ dataSync 类型前台服务的前置权限。
  - POST_NOTIFICATIONS：API 33+ 展示常驻通知的运行时权限（插件内按需请求）。
  - QrKeepAliveService：服务类在插件包 app.onethu.mobile 内，exported=false，
    仅 dataSync 类型（扫码最长 5 分钟，远低于 Android 14 每日限额）。
    服务名用全限定名，避免库清单相对名解析歧义。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="app.onethu.mobile.QrKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 桌面小组件：AppWidgetProvider 必须 exported=true（系统要投递
             APPWIDGET_UPDATE 广播），meta-data 指向 androidx 之外的 appwidget-provider
             元信息（最小尺寸/初始布局/30 分钟轮询）。 -->
        <receiver
            android:name="app.onethu.mobile.OnethuWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/onethu_widget_info" />
        </receiver>

        <!-- 点击落点广播：PendingIntent 里跑不了代码，先落到这里存 target 再拉起 App。
             exported=false：只由本应用自己的 PendingIntent 触发。 -->
        <receiver
            android:name="app.onethu.mobile.OnethuWidgetClickReceiver"
            android:exported="false" />
    </application>
</manifest>
