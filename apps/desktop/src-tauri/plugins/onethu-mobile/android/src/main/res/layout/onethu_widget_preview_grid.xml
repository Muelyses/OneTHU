<?xml version="1.0" encoding="utf-8"?>
<!--
  宿主小组件「图标组形态」（收藏夹）的选择器预览。

  previewLayout（API 31+）让启动器的选择器直接显示这块小组件长什么样：没有它，系统会拿
  initialLayout 当预览，而我们的 initialLayout 内容都是空的（真实内容由应用算好下发），
  在选择器里就是几个空框——「看不到 1×1」有一部分正是这个原因。
  预览里的文字与图标是写死的样例，不参与真实渲染。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/onethu_widget_bg"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#0F1115"
        android:text="常用" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="网"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F1115"
                android:background="@drawable/onethu_widget_bg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="#0F1115"
                android:text="网络学堂" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="卡"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F1115"
                android:background="@drawable/onethu_widget_bg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="#0F1115"
                android:text="校园卡" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="课"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F1115"
                android:background="@drawable/onethu_widget_bg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="#0F1115"
                android:text="课程表" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="日"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F1115"
                android:background="@drawable/onethu_widget_bg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="#0F1115"
                android:text="日程" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
