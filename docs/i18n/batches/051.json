      "parameters": [],
      "locations": [
        {
          "file": "apps/desktop/src/pages/info/LibRoomTab.tsx",
          "line": 84,
          "context": "{i18n(\"pages.info.libroomtab.f37e39e9300f\")}"
        }
      ],
      "translation": "The seminar room system requires signing in on the original website (cab.lib.tsinghua.edu.cn) and binding an email before you can make reservations. For new students without a bound email, it keeps reporting \"Session could not be established\". Please bind your email on the original website, then come back here and tap \"Retry\".",
      "status": "prefilled-review",
      "limitHint": "Preserve meaning; do not truncate."
