    {
      "key": "profile.sync.mergeHelp",
      "source": "默认自动合并不同字段和列表条目。此处有同一字段的矛盾或删除冲突；手动合并会保留双方条目，同一字段优先本机，删除冲突保留记录。",
      "kind": "text",
      "parameters": [],
      "locations": [
        {
          "file": "docs/i18n/static-label-seed.json",
          "line": 1
        }
      ],
      "translation": "Different fields and list items merge automatically. These items have same-field or deletion conflicts. A manual merge keeps entries from both sides, favors local values for competing fields, and retains edited records when deletion conflicts.",
      "status": "prefilled-review",
      "limitHint": "Preserve meaning; do not truncate."
    },
