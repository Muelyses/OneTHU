{
  "name": "@onethu/info-lib",
  "version": "3.6.4-mit.1",
  "description": "The JavaScript library that provides a program-friendly interface to Tsinghua web portal (thu-info-community, MIT boundary snapshot 06dc3cf0 + OneTHU 平台适配)",
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "keywords": [
    "tsinghua",
    "thuinfo",
    "thu-info",
    "onethu"
  ],
  "maintainers": [
    {
      "name": "UNIDY2002",
      "email": "UNIDY2002@outlook.com"
    },
    {
      "name": "Ashitemaru",
      "email": "qhd19@mails.tsinghua.edu.cn"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thu-info-community/thu-info-app.git"
  },
  "dependencies": {
    "cheerio": "1.0.0-rc.12",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.11",
    "he": "^1.2.0",
    "iconv-lite": "0.6.3",
    "image-size": "^1.0.1",
    "jspdf": "^2.5.1",
    "domelementtype": "2.3.0",
    "domhandler": "5.0.3",
    "cross-fetch": "4.0.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./network": {
      "import": "./dist/utils/network.js",
      "types": "./dist/utils/network.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "typescript": "5.5.3"
  }
}